OPENAI_API_KEY=
CARTENZA_OPENAI_MODEL=gpt-5.4-mini
CARTENZA_OPENAI_REASONING_EFFORT=none
CARTENZA_OPENAI_MAX_OUTPUT_TOKENS=24000
CARTENZA_GENERATION_PROMPT_VERSION=mission_generator_candidate_constrained_v0_1
CARTENZA_MISSION_OUTPUT_SCHEMA_VERSION=waymark.mission_output.v0.1
CARTENZA_APP_MISSION_SCHEMA_VERSION=mission.v0.2
CARTENZA_APP_MISSION_ADAPTER_VERSION=supabase_generate_first_mission_batch_adapter_v0_1
CARTENZA_ALPHA_REPLAY_MODE=false
CARTENZA_ALPHA_EVIDENCE_TERMS_VERSION=alpha_privacy_terms_v0_1
CARTENZA_ALPHA_REVIEW_NEEDED_APP_MISSION_POLICY=return_app_valid_missions
CARTENZA_ALPHA_DIAGNOSTIC_TERMS_VERSION=alpha_privacy_terms_v0_1

# Legacy WAYMARK_* names are still accepted by the functions. Prefer the
# CARTENZA_* names for new local env files and new hosted secrets.
# WAYMARK_OPENAI_MODEL=gpt-5.4-mini
# WAYMARK_OPENAI_REASONING_EFFORT=none
# WAYMARK_OPENAI_MAX_OUTPUT_TOKENS=24000
# WAYMARK_GENERATION_PROMPT_VERSION=mission_generator_candidate_constrained_v0_1
# WAYMARK_MISSION_OUTPUT_SCHEMA_VERSION=waymark.mission_output.v0.1
# WAYMARK_APP_MISSION_SCHEMA_VERSION=mission.v0.2
# WAYMARK_APP_MISSION_ADAPTER_VERSION=supabase_generate_first_mission_batch_adapter_v0_1
# WAYMARK_ALPHA_REPLAY_MODE=false
# WAYMARK_ALPHA_EVIDENCE_TERMS_VERSION=alpha_privacy_terms_v0_1
# WAYMARK_ALPHA_REVIEW_NEEDED_APP_MISSION_POLICY=return_app_valid_missions
# WAYMARK_ALPHA_DIAGNOSTIC_TERMS_VERSION=alpha_privacy_terms_v0_1

# Supabase hosted functions receive these automatically. For local function
# logging tests, set them from your project settings.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
