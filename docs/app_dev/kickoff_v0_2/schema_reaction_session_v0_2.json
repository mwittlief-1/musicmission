{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://music-atlas.local/schemas/reaction_session_v0_2.json",
  "title": "Music Atlas Reaction Session v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "mission_id",
    "mission_version",
    "created_at",
    "started_at",
    "reconciliation_status",
    "device_context",
    "music_context",
    "item_results",
    "export"
  ],
  "properties": {
    "schema_version": {
      "const": "reaction_session.v0.2"
    },
    "session_id": {
      "type": "string",
      "pattern": "^SESS_[A-Z0-9_]+$"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^MIS_[A-Z0-9_]+$"
    },
    "mission_version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+(\\.\\d+)?$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "reconciliation_status": {
      "type": "string",
      "enum": [
        "not_reconciled",
        "reconciliation_candidate",
        "reconciled",
        "ignored"
      ],
      "default": "not_reconciled"
    },
    "device_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_model",
        "os_version",
        "app_version",
        "is_physical_device"
      ],
      "properties": {
        "device_model": {
          "type": "string",
          "minLength": 1
        },
        "os_version": {
          "type": "string",
          "minLength": 1
        },
        "app_version": {
          "type": "string",
          "minLength": 1
        },
        "is_physical_device": {
          "type": "boolean"
        }
      }
    },
    "music_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_status",
        "playback_capability_status"
      ],
      "properties": {
        "authorization_status": {
          "type": "string",
          "enum": [
            "notDetermined",
            "denied",
            "restricted",
            "authorized"
          ]
        },
        "playback_capability_status": {
          "type": "string",
          "enum": [
            "unknown",
            "capable",
            "not_subscribed",
            "restricted",
            "unavailable",
            "failed"
          ]
        },
        "storefront": {
          "type": "string"
        },
        "subscription_notes": {
          "type": "string"
        }
      }
    },
    "item_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mission_item_id",
          "sequence",
          "item_type",
          "artist",
          "title",
          "resolution",
          "playback",
          "reaction",
          "timestamps"
        ],
        "properties": {
          "mission_item_id": {
            "type": "string",
            "pattern": "^ITEM_[A-Z0-9_]+$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "item_type": {
            "type": "string",
            "enum": [
              "track",
              "album"
            ]
          },
          "artist": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "album": {
            "type": "string"
          },
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "unresolved",
                  "resolved",
                  "ambiguous",
                  "skipped",
                  "unavailable_region",
                  "unavailable_subscription",
                  "failed"
                ]
              },
              "catalog_id": {
                "type": "string",
                "minLength": 1
              },
              "catalog_url": {
                "type": "string",
                "format": "uri"
              },
              "storefront": {
                "type": "string",
                "minLength": 2
              },
              "resolved_title": {
                "type": "string",
                "minLength": 1
              },
              "resolved_artist": {
                "type": "string",
                "minLength": 1
              },
              "resolved_album": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "resolver": {
                "type": "string",
                "enum": [
                  "not_attempted",
                  "automatic_search",
                  "manual_selection",
                  "cached",
                  "system"
                ]
              },
              "resolved_at": {
                "type": "string",
                "format": "date-time"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "candidate_count": {
                "type": "integer",
                "minimum": 0
              },
              "error_code": {
                "type": "string",
                "minLength": 1
              },
              "error_message": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "resolved"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "catalog_id",
                    "resolved_title",
                    "resolved_artist",
                    "confidence",
                    "resolver",
                    "resolved_at"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "unresolved",
                        "skipped",
                        "unavailable_region",
                        "unavailable_subscription",
                        "failed"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "reason"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "ambiguous"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "candidate_count",
                    "reason"
                  ]
                }
              }
            ]
          },
          "playback": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "not_attempted",
                  "queued",
                  "playing",
                  "played",
                  "skipped",
                  "failed"
                ]
              },
              "attempted_at": {
                "type": "string",
                "format": "date-time"
              },
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "ended_at": {
                "type": "string",
                "format": "date-time"
              },
              "duration_seconds": {
                "type": "number",
                "minimum": 0
              },
              "error_code": {
                "type": "string"
              },
              "error_message": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "queued",
                        "playing",
                        "played",
                        "failed"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "attempted_at"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "failed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "error_message"
                  ]
                }
              }
            ]
          },
          "reaction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reaction_value",
              "reacted_at",
              "notes"
            ],
            "properties": {
              "reaction_value": {
                "type": "string",
                "enum": [
                  "hit",
                  "partial",
                  "ok_shelf",
                  "miss",
                  "slop",
                  "skipped",
                  "unresolved"
                ]
              },
              "reacted_at": {
                "type": "string",
                "format": "date-time"
              },
              "notes": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "voice_note_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "timestamps": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "created_at",
              "updated_at"
            ],
            "properties": {
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "session_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item_count": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_count": {
          "type": "integer",
          "minimum": 0
        },
        "played_count": {
          "type": "integer",
          "minimum": 0
        },
        "reaction_count": {
          "type": "integer",
          "minimum": 0
        },
        "summary_note": {
          "type": "string"
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exported_at",
        "json_filename",
        "markdown_filename"
      ],
      "properties": {
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "json_filename": {
          "type": "string",
          "minLength": 1
        },
        "markdown_filename": {
          "type": "string",
          "minLength": 1
        },
        "validation_status": {
          "type": "string",
          "enum": [
            "not_validated",
            "valid",
            "invalid"
          ]
        },
        "validation_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}