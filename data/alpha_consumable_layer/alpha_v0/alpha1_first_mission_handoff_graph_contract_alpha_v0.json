    ],
    "supabase_infrastructure": [
      "live project/account access",
      "evidence upload endpoint"
    ],
    "brand_design_release": [
      "final privacy copy",
      "final terms copy",
      "final onboarding copy",
      "final FAQ copy"
    ]
  },
  "graph_lane_ready_for_core_integration": true,
  "route_identity_contract": "data/alpha_consumable_layer/alpha_v0/alpha_route_identity_contract_alpha_v0.json",
  "route_identity_policy": {
    "route_items_must_come_from_candidate_pool": true,
    "digest_or_strong_region_items_without_candidate_pool_membership_allowed": false,
    "display_string_identity_is_primary": false,
    "route_items_should_copy": {
      "candidate_id": "candidate_id",
      "item_id": "app_route_item_id",
      "route_candidate_key": "route_candidate_key",
      "route_batch_dedupe_key": "route_batch_dedupe_key"
    },
    "single_mission_unique_fields": [
