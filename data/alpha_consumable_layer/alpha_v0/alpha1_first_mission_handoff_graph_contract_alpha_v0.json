    "11": "electronic_version_caution",
    "13": "language_remix_collaboration_caution",
    "14": "work_recording_caution",
    "16": "worship_standard_church_brand_caution"
  },
  "graph_lane_non_claims": [
    "user_likes_candidate",
    "candidate_is_atlas_landmark",
    "candidate_is_atlas_region_member",
    "candidate_is_confirmed_dead_end",
    "candidate_is_apple_music_auto_resolvable_when_policy_requires_manual_review"
  ],
  "safe_to_send_to_supabase_when": [
    "source_contract_version == alpha_v0",
    "eligible_for_supabase == true",
    "review_status == approved",
    "playable_route_ready == true",
    "object_type in [track, album]",
    "music_object_ref validates",
    "no quarantine or blocklist policy applies",
    "tile_log_metadata is preserved"
  ],
  "safe_to_send_to_openai_when": [
    "payload is compact",
    "raw graph rows are excluded",
    "hidden simulation truth is excluded",
    "quarantined and manual-review rows are excluded",
    "graph_metadata_taste_truth == false"
  ],
  "downstream_blockers": {
    "atlas_schema": [
