  "allowed_candidate_pool_behaviors": [
    "anchor",
    "bridge",
    "probe",
    "risky_probe",
    "waypoint",
    "trap"
  ],
  "blocked_candidate_pool_behaviors": [
    "exclude",
    "unknown"
  ],
  "route_ready_requirements": {
    "candidate_object_type": [
      "track",
      "album"
    ],
    "track_ref_rule": "object_type=track must carry music_object_ref.object_type=song_recording",
    "album_ref_rule": "object_type=album must carry music_object_ref.object_type=album",
    "artist_level_route_candidates_allowed": false,
    "pseudo_playable_items_allowed": false,
    "resolver_step_required_before_playback": true
  },
  "review_gate_policy": {
    "alpha_safe_with_review_flags_is_hard_block": false,
    "generate_allowed_store_review_flags": "Preserve caution/review metadata while continuing Alpha generation attempts.",
    "hard_block_only_for": [
      "hard_block == true",
      "default_alpha_mission_eligible != true",
      "review_status != approved",
      "quarantine_status != clear",
      "suppression_status != active",
      "manual_review_required == true",
      "context_only == true",
      "object_type not in [track, album]",
      "route item candidate_id not present in supplied candidate pool",
      "duplicate route_candidate_key within mission or batch",
      "duplicate route_batch_dedupe_key within mission or batch",
      "duplicate app_route_item_id within mission or batch",
      "duplicate route_display_identity_key within mission or batch when stronger keys differ or are missing"
    ]
  },
  "eligible_default_first_mission_families": [
    1,
    2,
    3,
    4,
