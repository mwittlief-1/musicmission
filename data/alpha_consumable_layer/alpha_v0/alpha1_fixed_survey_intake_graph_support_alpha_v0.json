    "must_ignore_path": "survey_evidence_export.construction_only_excluded",
    "same_session_display_history_required": true,
    "dont_know_mapping": "familiarity_uncertainty",
    "evidence_strength_hint_policy": "survey_metadata_only_not_atlas_confidence"
  },
  "pass_fail": {
