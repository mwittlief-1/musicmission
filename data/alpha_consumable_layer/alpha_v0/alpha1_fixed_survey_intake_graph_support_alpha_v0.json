  "hard_blocks": [
    "review_status != approved",
    "quarantine_reasons non-empty",
    "candidate appears in alpha_candidate_blocklist",
    "typed entity ref appears in canonical_quarantine_queue",
    "song recording missing canonical_recording_versions row",
    "song recording review_status != approved",
    "song recording survey_safe != true",
    "song recording apple_music_resolution_policy == manual_review_required",
    "family is context_only",
    "archetype readiness is context_only for Fast Survey"
  ],
  "dedupe_rules": {
    "within_page": [
      "no duplicate candidate_id",
      "no duplicate canonical_entity_id",
      "no duplicate dedupe_group"
    ],
    "across_fixed_intake": [
      "Survey lane may repeat a dedupe group only if explicitly marked as a version/composition test; Alpha default should avoid repeats."
    ]
  },
  "graph_truth_rules": {
    "graph_metadata_taste_truth": false,
    "survey_response_creates_atlas_role": false,
    "survey_response_creates_landmark_region_or_dead_end": false,
    "apple_payload_is_taste_truth": false,
    "apple_payload_is_identity_truth": false
