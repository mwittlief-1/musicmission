{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "waymark.survey_evidence_export.v0.1",
  "title": "Waymark Survey Evidence Export v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "created_at",
    "source",
    "ledger_semantics",
    "private_data_boundary",
    "reaction_operation_legend",
    "atlas_ingestable",
    "construction_only_excluded"
  ],
  "properties": {
    "schema_version": {
      "const": "waymark.survey_evidence_export.v0.1"
    },
    "export_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_public_id",
        "apple_payload_id",
        "survey_run_id",
        "source_packet_path",
        "source_packet_schema_version",
        "source_input_fingerprint",
        "source_public_packet_sha256",
        "page_count_config"
      ],
      "properties": {
        "profile_public_id": { "type": "string" },
        "apple_payload_id": { "type": "string" },
        "survey_run_id": { "type": "string" },
        "source_packet_path": { "type": "string" },
        "source_packet_schema_version": { "type": "string" },
        "source_input_fingerprint": { "type": "string" },
        "source_public_packet_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "page_count_config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config_id",
            "artist_pages",
            "album_pages",
            "song_pages",
            "tile_count"
          ],
          "properties": {
            "config_id": { "type": "string" },
            "artist_pages": { "type": "integer", "minimum": 0 },
            "album_pages": { "type": "integer", "minimum": 0 },
            "song_pages": { "type": "integer", "minimum": 0 },
            "tile_count": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "ledger_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "mutation_policy",
        "correction_policy"
      ],
      "properties": {
        "mode": { "const": "append_only" },
        "mutation_policy": { "const": "do_not_rewrite_existing_evidence_atoms" },
        "correction_policy": { "const": "append_superseding_evidence_or_correction_atom" }
      }
    },
    "private_data_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_simulator_data_excluded",
        "profile_writer_prose_excluded",
        "raw_page_construction_payloads_excluded",
        "raw_ranking_scores_excluded",
        "graph_meanings_unavailable_to_visible_packet_excluded"
      ],
      "properties": {
        "private_simulator_data_excluded": { "const": true },
        "profile_writer_prose_excluded": { "const": true },
        "raw_page_construction_payloads_excluded": { "const": true },
        "raw_ranking_scores_excluded": { "const": true },
        "graph_meanings_unavailable_to_visible_packet_excluded": { "const": true }
      }
    },
    "reaction_operation_legend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "love",
        "like",
        "ok",
        "dont_like",
        "dont_know_enough"
      ],
      "properties": {
        "love": { "$ref": "#/$defs/reaction_operation" },
        "like": { "$ref": "#/$defs/reaction_operation" },
        "ok": { "$ref": "#/$defs/reaction_operation" },
        "dont_like": { "$ref": "#/$defs/reaction_operation" },
        "dont_know_enough": { "$ref": "#/$defs/reaction_operation" }
      }
    },
    "atlas_ingestable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_atoms",
        "response_ref_index"
      ],
      "properties": {
        "evidence_atoms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_atom" }
        },
        "response_ref_index": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_refs",
            "response_ids"
          ],
          "properties": {
            "evidence_refs": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "response_ids": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "construction_only_excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atlas_ingestable",
        "excluded_field_categories",
        "excluded_field_counts",
        "quarantined_response_refs"
      ],
      "properties": {
        "atlas_ingestable": { "const": false },
        "excluded_field_categories": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "excluded_field_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "quarantined_response_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_response_id",
              "source_evidence_ref",
              "unresolved_response_ref",
              "reason"
            ],
            "properties": {
              "source_response_id": { "type": "string" },
              "source_evidence_ref": { "type": "string" },
              "unresolved_response_ref": { "type": "string" },
              "reason": {
                "enum": [
                  "missing_displayed_page",
                  "missing_tile_or_ref",
                  "invalid_response_state",
                  "duplicate_response",
                  "schema_mismatch",
                  "non_visible_construction_data",
                  "apple_only_unmatched_object"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "reaction_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_operation",
        "taste_polarity",
        "atlas_signal"
      ],
      "properties": {
        "normalized_operation": {
          "enum": [
            "positive_high",
            "positive_medium",
            "waypoint_context",
            "negative_scope_carefully",
            "familiarity_uncertainty"
          ]
        },
        "taste_polarity": {
          "enum": [
            "positive",
            "contextual",
            "negative",
            "none"
          ]
        },
        "atlas_signal": {
          "enum": [
            "strong_positive",
            "positive",
            "weak_positive_or_familiarity",
            "negative_scope_carefully",
            "familiarity_uncertainty"
          ]
        }
      }
    },
    "evidence_atom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_atom_id",
        "atom_type",
        "atlas_ingestable",
        "response_id",
        "evidence_ref",
        "music_object_ref",
        "reaction",
        "evidence_strength_hint",
        "tags",
        "note",
        "page_context",
        "comparison_set",
        "supporting_visible_response_refs",
        "graph_refs",
        "apple_exposure_prior",
        "provenance",
        "timestamps"
      ],
      "properties": {
        "evidence_atom_id": { "type": "string" },
        "atom_type": { "const": "survey_response" },
        "atlas_ingestable": { "const": true },
        "response_id": { "type": "string" },
        "evidence_ref": { "type": "string" },
        "music_object_ref": { "$ref": "#/$defs/music_object_ref" },
        "reaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_value",
            "normalized_operation",
            "taste_polarity",
            "atlas_signal"
          ],
          "properties": {
            "raw_value": {
              "enum": [
                "love",
                "like",
                "ok",
                "dont_like",
                "dont_know_enough"
              ]
            },
            "normalized_operation": {
              "enum": [
                "positive_high",
                "positive_medium",
                "waypoint_context",
                "negative_scope_carefully",
                "familiarity_uncertainty"
              ]
            },
            "taste_polarity": {
              "enum": [
                "positive",
                "contextual",
                "negative",
                "none"
              ]
            },
            "atlas_signal": {
              "enum": [
                "strong_positive",
                "positive",
                "weak_positive_or_familiarity",
                "negative_scope_carefully",
                "familiarity_uncertainty"
              ]
            }
          }
        },
        "evidence_strength_hint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "basis",
            "hint",
            "is_final_atlas_confidence",
            "note"
          ],
          "properties": {
            "source": { "const": "survey" },
            "basis": { "const": "reaction_operation_and_visible_page_context" },
            "hint": {
              "enum": [
                "strong_positive_basis",
                "medium_positive_basis",
                "waypoint_or_context_basis",
                "negative_scope_basis",
                "familiarity_uncertainty_basis"
              ]
            },
            "is_final_atlas_confidence": { "const": false },
            "note": { "type": "string" }
          }
        },
        "tags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected",
            "selected_semantics",
            "shown_but_unselected",
            "shown_but_unselected_semantics"
          ],
          "properties": {
            "selected": {
              "type": "array",
              "items": { "type": "string" }
            },
            "selected_semantics": {
              "const": "visible_signal_evidence"
            },
            "shown_but_unselected": {
              "type": "array",
              "items": { "type": "string" }
            },
            "shown_but_unselected_semantics": {
              "const": "weak_non_selected_context"
            }
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "page_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page_id",
            "stage",
            "page_number",
            "page_intent",
            "candidate_basis"
          ],
          "properties": {
            "page_id": { "type": "string" },
            "stage": {
              "enum": [
                "artist",
                "album",
                "song"
              ]
            },
            "page_number": { "type": "integer", "minimum": 1 },
            "page_intent": { "type": "string" },
            "candidate_basis": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "comparison_set": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "comparison_set_id",
            "stage",
            "page_number",
            "peer_count",
            "peer_response_refs"
          ],
          "properties": {
            "comparison_set_id": { "type": "string" },
            "stage": {
              "enum": [
                "artist",
                "album",
                "song"
              ]
            },
            "page_number": { "type": "integer", "minimum": 1 },
            "peer_count": { "type": "integer", "minimum": 1 },
            "peer_response_refs": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        },
        "supporting_visible_response_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_ref",
              "relation"
            ],
            "properties": {
              "evidence_ref": { "type": "string" },
              "relation": { "const": "visible_prior_response_used_by_selector" }
            }
          }
        },
        "graph_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family_numbers",
            "archetype_ids",
            "roles",
            "best_recognition_tier",
            "best_survey_tier"
          ],
          "properties": {
            "family_numbers": {
              "type": "array",
              "items": { "type": "integer" }
            },
            "archetype_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "roles": {
              "type": "array",
              "items": { "type": "string" }
            },
            "best_recognition_tier": { "type": "string" },
            "best_survey_tier": { "type": "string" }
          }
        },
        "apple_exposure_prior": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "interpretation",
            "is_present",
            "taste_truth",
            "signal_ids",
            "dimensions"
          ],
          "properties": {
            "source": { "const": "apple_music" },
            "interpretation": { "const": "exposure_prior" },
            "is_present": { "type": "boolean" },
            "taste_truth": { "const": false },
            "signal_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "dimensions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "exact_signal_weight": { "type": "number" },
                "exposure_score": { "type": "number" },
                "recency_score": { "type": "number" },
                "repetition_score": { "type": "number" },
                "library_commitment_score": { "type": "number" },
                "favorite_or_rating_score": { "type": "number" },
                "playlist_context_score": { "type": "number" },
                "album_completion_hint": { "type": "number" },
                "artist_depth_hint": { "type": "number" }
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_packet_schema_version",
            "source_run_id",
            "source_input_fingerprint",
            "source_public_packet_sha256",
            "response_id",
            "evidence_ref"
          ],
          "properties": {
            "source_packet_schema_version": { "type": "string" },
            "source_run_id": { "type": "string" },
            "source_input_fingerprint": { "type": "string" },
            "source_public_packet_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "response_id": { "type": "string" },
            "evidence_ref": { "type": "string" }
          }
        },
        "timestamps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "survey_packet_created_at",
            "exported_at"
          ],
          "properties": {
            "survey_packet_created_at": {
              "type": "string",
              "format": "date-time"
            },
            "exported_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "music_object_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "ref_source",
        "display_name",
        "resolution_state"
      ],
      "properties": {
        "object_type": {
          "enum": [
            "artist",
            "album",
            "song_recording"
          ]
        },
        "ref_source": { "type": "string" },
        "canonical_artist_id": { "type": "string" },
        "canonical_album_id": { "type": "string" },
        "canonical_song_recording_id": { "type": "string" },
        "display_name": { "type": "string" },
        "artist_display_name": { "type": "string" },
        "resolution_state": { "type": "string" }
      }
    }
  }
}
