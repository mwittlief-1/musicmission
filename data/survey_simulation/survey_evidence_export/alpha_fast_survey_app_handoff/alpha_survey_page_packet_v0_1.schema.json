{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "waymark.alpha_survey_page_packet.v0.1",
  "title": "Waymark Alpha Survey Page Packet v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "created_at",
    "source",
    "page_count_recommendation",
    "response_state_contract",
    "tag_and_note_contract",
    "private_data_boundary",
    "evidence_export_compatibility",
    "blocking_dependencies",
    "pages"
  ],
  "properties": {
    "schema_version": { "const": "waymark.alpha_survey_page_packet.v0.1" },
    "packet_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_public_id",
        "apple_payload_id",
        "survey_run_id",
        "source_packet_schema_version",
        "source_packet_path",
        "source_public_packet_sha256",
        "source_input_fingerprint"
      ],
      "properties": {
        "profile_public_id": { "type": "string" },
        "apple_payload_id": { "type": "string" },
        "survey_run_id": { "type": "string" },
        "source_packet_schema_version": { "type": "string" },
        "source_packet_path": { "type": "string" },
        "source_public_packet_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_input_fingerprint": { "type": "string" }
      }
    },
    "page_count_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_id",
        "artist_pages",
        "album_pages",
        "song_pages",
        "tile_count",
        "alpha_status",
        "qualification"
      ],
      "properties": {
        "config_id": { "type": "string" },
        "artist_pages": { "type": "integer", "minimum": 0 },
        "album_pages": { "type": "integer", "minimum": 0 },
        "song_pages": { "type": "integer", "minimum": 0 },
        "tile_count": { "type": "integer", "minimum": 1 },
        "alpha_status": {
          "enum": [
            "recommended_fast_survey_fallback",
            "required_alpha1_intake",
            "evaluated_page_count_config",
            "render_example_not_onboarding_recommendation"
          ]
        },
        "qualification": { "type": "string" }
      }
    },
    "response_state_contract": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/response_state" }
    },
    "tag_and_note_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_tags",
        "shown_unselected_tags",
        "note"
      ],
      "properties": {
        "selected_tags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "required", "empty_allowed", "signal_semantics"],
          "properties": {
            "type": { "const": "array" },
            "required": { "const": true },
            "empty_allowed": { "const": true },
            "signal_semantics": { "const": "visible_signal_evidence" }
          }
        },
        "shown_unselected_tags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "required", "empty_allowed", "signal_semantics"],
          "properties": {
            "type": { "const": "array" },
            "required": { "const": true },
            "empty_allowed": { "const": true },
            "signal_semantics": { "const": "weak_non_selected_context" }
          }
        },
        "note": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "required", "empty_allowed"],
          "properties": {
            "type": { "const": "string_or_null" },
            "required": { "const": true },
            "empty_allowed": { "const": true }
          }
        }
      }
    },
    "private_data_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_simulator_truth_excluded",
        "hidden_corpus_reactions_excluded",
        "hidden_reason_tags_excluded",
        "lookup_state_excluded",
        "raw_candidate_scores_excluded",
        "generation_prompts_excluded",
        "profile_writer_prose_excluded"
      ],
      "properties": {
        "private_simulator_truth_excluded": { "const": true },
        "hidden_corpus_reactions_excluded": { "const": true },
        "hidden_reason_tags_excluded": { "const": true },
        "lookup_state_excluded": { "const": true },
        "raw_candidate_scores_excluded": { "const": true },
        "generation_prompts_excluded": { "const": true },
        "profile_writer_prose_excluded": { "const": true }
      }
    },
    "evidence_export_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_schema_version",
        "target_atlas_flow",
        "one_atom_per_visible_response",
        "apple_exports_as_exposure_prior",
        "apple_taste_truth_required_value",
        "construction_only_excluded_outside_atlas_ingestion"
      ],
      "properties": {
        "target_schema_version": { "const": "waymark.survey_evidence_export.v0.1" },
        "target_atlas_flow": {
          "const": [
            "Survey Evidence Export",
            "Signal",
            "AtlasNode",
            "provisional AtlasRoleAssignment",
            "PossibleAtlasUpdateCandidate",
            "AtlasDigestView"
          ]
        },
        "one_atom_per_visible_response": { "const": true },
        "apple_exports_as_exposure_prior": { "const": true },
        "apple_taste_truth_required_value": { "const": false },
        "construction_only_excluded_outside_atlas_ingestion": { "const": true }
      }
    },
    "blocking_dependencies": {
      "type": "array",
      "items": {
        "enum": [
          "Atlas ingestion semantics",
          "App decision on whether Survey appears in this TestFlight build",
          "Final Canonical family/label policy"
        ]
      },
      "uniqueItems": true
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "response_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "app_label",
        "normalized_operation",
        "atlas_signal",
        "taste_polarity"
      ],
      "properties": {
        "state": {
          "enum": [
            "love",
            "like",
            "ok",
            "dont_like",
            "dont_know_enough"
          ]
        },
        "app_label": { "type": "string" },
        "normalized_operation": {
          "enum": [
            "positive_high",
            "positive_medium",
            "waypoint_context",
            "negative_scope_carefully",
            "familiarity_uncertainty"
          ]
        },
        "atlas_signal": {
          "enum": [
            "strong_positive",
            "positive",
            "weak_positive_or_familiarity",
            "negative_scope_carefully",
            "familiarity_uncertainty"
          ]
        },
        "taste_polarity": {
          "enum": [
            "positive",
            "contextual",
            "negative",
            "none"
          ]
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "stage",
        "page_number",
        "tile_count",
        "rendering",
        "tiles"
      ],
      "properties": {
        "page_id": { "type": "string" },
        "stage": { "enum": ["artist", "album", "song"] },
        "page_number": { "type": "integer", "minimum": 1 },
        "tile_count": { "const": 12 },
        "rendering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layout", "columns", "requires_ordered_tiles"],
          "properties": {
            "layout": { "const": "grid" },
            "columns": { "type": "string" },
            "requires_ordered_tiles": { "const": true }
          }
        },
        "tiles": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/tile" }
        }
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "render_tile_id",
        "display_order",
        "response_id",
        "evidence_ref",
        "music_object_ref",
        "display",
        "page_intent",
        "candidate_basis",
        "approved_graph_surface_ref",
        "graph_refs",
        "apple_exposure_prior",
        "response_capture",
        "evidence_export_linkage"
      ],
      "properties": {
        "render_tile_id": { "type": "string" },
        "display_order": { "type": "integer", "minimum": 1, "maximum": 12 },
        "response_id": { "type": "string" },
        "evidence_ref": { "type": "string" },
        "music_object_ref": { "$ref": "#/$defs/music_object_ref" },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_text", "secondary_text", "object_type"],
          "properties": {
            "primary_text": { "type": "string" },
            "secondary_text": { "type": ["string", "null"] },
            "object_type": { "enum": ["artist", "album", "song_recording"] }
          }
        },
        "page_intent": { "type": "string" },
        "candidate_basis": {
          "type": "array",
          "items": { "type": "string" }
        },
        "approved_graph_surface_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "review_status",
            "candidate_id",
            "survey_page_role",
            "survey_intent",
            "source_membership_id"
          ],
          "properties": {
            "source": { "const": "canonical_graph_survey_surface_v0_2" },
            "review_status": {
              "enum": ["approved", "not_found_in_approved_surface"]
            },
            "candidate_id": { "type": ["string", "null"] },
            "survey_page_role": { "type": ["string", "null"] },
            "survey_intent": { "type": ["string", "null"] },
            "source_membership_id": { "type": ["string", "null"] }
          }
        },
        "graph_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family_numbers",
            "archetype_ids",
            "roles",
            "best_recognition_tier",
            "best_survey_tier"
          ],
          "properties": {
            "family_numbers": {
              "type": "array",
              "items": { "type": "integer" }
            },
            "archetype_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "roles": {
              "type": "array",
              "items": { "type": "string" }
            },
            "best_recognition_tier": { "type": "string" },
            "best_survey_tier": { "type": "string" }
          }
        },
        "apple_exposure_prior": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "interpretation",
            "taste_truth",
            "is_present",
            "signal_ids",
            "dimensions"
          ],
          "properties": {
            "source": { "const": "apple_music" },
            "interpretation": { "const": "exposure_prior" },
            "taste_truth": { "const": false },
            "is_present": { "type": "boolean" },
            "signal_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "dimensions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "exact_signal_weight": { "type": "number" },
                "exposure_score": { "type": "number" },
                "recency_score": { "type": "number" },
                "repetition_score": { "type": "number" },
                "library_commitment_score": { "type": "number" },
                "favorite_or_rating_score": { "type": "number" },
                "playlist_context_score": { "type": "number" },
                "album_completion_hint": { "type": "number" },
                "artist_depth_hint": { "type": "number" }
              }
            }
          }
        },
        "response_capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_states",
            "selected_tags",
            "selected_tags_semantics",
            "shown_unselected_tags",
            "shown_unselected_tags_semantics",
            "note",
            "captured_state",
            "normalized_operation"
          ],
          "properties": {
            "allowed_states": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "enum": [
                  "love",
                  "like",
                  "ok",
                  "dont_like",
                  "dont_know_enough"
                ]
              }
            },
            "selected_tags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "selected_tags_semantics": {
              "const": "visible_signal_evidence"
            },
            "shown_unselected_tags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "shown_unselected_tags_semantics": {
              "const": "weak_non_selected_context"
            },
            "note": { "type": ["string", "null"] },
            "captured_state": {
              "anyOf": [
                {
                  "enum": [
                    "love",
                    "like",
                    "ok",
                    "dont_like",
                    "dont_know_enough"
                  ]
                },
                { "type": "null" }
              ]
            },
            "normalized_operation": {
              "anyOf": [
                {
                  "enum": [
                    "positive_high",
                    "positive_medium",
                    "waypoint_context",
                    "negative_scope_carefully",
                    "familiarity_uncertainty"
                  ]
                },
                { "type": "null" }
              ]
            }
          }
        },
        "evidence_export_linkage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_atom_id",
            "response_id",
            "evidence_ref",
            "supporting_visible_response_refs"
          ],
          "properties": {
            "evidence_atom_id": { "type": "string" },
            "response_id": { "type": "string" },
            "evidence_ref": { "type": "string" },
            "supporting_visible_response_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["response_id", "evidence_ref", "relation"],
                "properties": {
                  "response_id": { "type": "string" },
                  "evidence_ref": { "type": "string" },
                  "relation": { "const": "visible_prior_response_used_by_selector" }
                }
              }
            }
          }
        }
      }
    },
    "music_object_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "ref_source",
        "display_name",
        "resolution_state"
      ],
      "properties": {
        "object_type": { "enum": ["artist", "album", "song_recording"] },
        "ref_source": { "type": "string" },
        "canonical_artist_id": { "type": "string" },
        "canonical_album_id": { "type": "string" },
        "canonical_song_recording_id": { "type": "string" },
        "display_name": { "type": "string" },
        "artist_display_name": { "type": "string" },
        "resolution_state": { "type": "string" }
      }
    }
  }
}
