{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cartenza.local/contracts/mission_opportunity_selection/mission_type_registry_v0_1.schema.json",
  "title": "Cartenza Mission Type Registry v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "fixture_status",
    "runtime_allowed",
    "production_mission_generation_allowed",
    "canonical_graph_mutation_allowed",
    "listener_preference_inference_from_affinity_allowed",
    "global_top_k_opportunities",
    "mission_types"
  ],
  "properties": {
    "contract_version": { "const": "mission_type_registry_v0_1" },
    "fixture_status": { "const": "synthetic_contract_fixture" },
    "runtime_allowed": { "const": false },
    "production_mission_generation_allowed": { "const": false },
    "canonical_graph_mutation_allowed": { "const": false },
    "listener_preference_inference_from_affinity_allowed": { "const": false },
    "global_top_k_opportunities": { "const": 25 },
    "mission_types": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/mission_type_definition" }
    }
  },
  "$defs": {
    "mission_type": {
      "enum": [
        "initial_profile_survey",
        "family_survey",
        "archetype_survey",
        "gateway_test",
        "song_to_archetype_test",
        "artist_depth_test",
        "album_container_test",
        "archetype_depth_test",
        "exception_scope_test",
        "false_nearby_test",
        "context_dependence_test",
        "bridge_test",
        "boundary_test",
        "evidence_repair_test"
      ]
    },
    "value_band": {
      "enum": ["low", "lower_medium", "medium", "high", "very_high"]
    },
    "target_object_type": {
      "enum": [
        "family",
        "archetype",
        "artist",
        "album",
        "song",
        "archetype_pair",
        "family_pair",
        "song_cluster"
      ]
    },
    "score_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_type_value",
        "mission_fit_score",
        "readiness_score",
        "learning_value_score",
        "risk_penalty",
        "repetition_penalty",
        "complexity_penalty"
      ],
      "properties": {
        "mission_type_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "mission_fit_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "readiness_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "learning_value_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "risk_penalty": { "type": "number", "minimum": 0, "maximum": 1 },
        "repetition_penalty": { "type": "number", "minimum": 0, "maximum": 1 },
        "complexity_penalty": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "candidate_generation_caps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_targets",
        "max_candidates_per_target",
        "batch_size",
        "max_candidates_total",
        "cap_reason"
      ],
      "properties": {
        "max_targets": { "type": "integer", "minimum": 1 },
        "max_candidates_per_target": { "type": "integer", "minimum": 1 },
        "batch_size": { "type": "integer", "minimum": 1 },
        "max_candidates_total": { "type": "integer", "minimum": 1 },
        "cap_reason": { "type": "string", "minLength": 1 }
      }
    },
    "required_blob_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_object_types",
        "requires_graph_context",
        "requires_evidence_rollup",
        "requires_affinity_context",
        "requires_risk_context",
        "requires_candidate_generation_summary",
        "requires_floor_details",
        "requires_score_components"
      ],
      "properties": {
        "target_object_types": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/target_object_type" },
          "uniqueItems": true
        },
        "requires_graph_context": { "const": true },
        "requires_evidence_rollup": { "type": "boolean" },
        "requires_affinity_context": { "type": "boolean" },
        "requires_risk_context": { "type": "boolean" },
        "requires_candidate_generation_summary": { "const": true },
        "requires_floor_details": { "const": true },
        "requires_score_components": { "const": true },
        "requires_bridge_readiness": { "type": "boolean" },
        "requires_gateway_availability": { "type": "boolean" }
      }
    },
    "mission_type_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_type",
        "value_band",
        "score_floor",
        "score_ceiling",
        "floor_summary",
        "ceiling_summary",
        "required_blob_shape",
        "scoring_weights",
        "candidate_generation_caps",
        "runtime_allowed",
        "production_mission_generation_allowed"
      ],
      "properties": {
        "mission_type": { "$ref": "#/$defs/mission_type" },
        "value_band": { "$ref": "#/$defs/value_band" },
        "score_floor": { "type": "number", "minimum": 0, "maximum": 1 },
        "score_ceiling": { "type": "number", "minimum": 0, "maximum": 1 },
        "floor_summary": { "type": "string", "minLength": 1 },
        "ceiling_summary": { "type": "string", "minLength": 1 },
        "required_blob_shape": { "$ref": "#/$defs/required_blob_shape" },
        "scoring_weights": { "$ref": "#/$defs/score_weights" },
        "candidate_generation_caps": { "$ref": "#/$defs/candidate_generation_caps" },
        "runtime_allowed": { "const": false },
        "production_mission_generation_allowed": { "const": false }
      }
    }
  }
}
