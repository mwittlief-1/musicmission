{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cartenza.local/contracts/mission_opportunity_selection/evidence_rollup_v0_1.schema.json",
  "title": "Cartenza Evidence Rollup v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "fixture_status",
    "listener_state_id",
    "created_at",
    "runtime_listener_evidence_connected",
    "canonical_graph_mutation_allowed",
    "listener_preference_inference_from_affinity_allowed",
    "reaction_semantics",
    "evidence_signals",
    "rollups"
  ],
  "properties": {
    "contract_version": { "const": "evidence_rollup_v0_1" },
    "fixture_status": { "const": "synthetic_contract_fixture" },
    "listener_state_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "runtime_listener_evidence_connected": { "const": false },
    "canonical_graph_mutation_allowed": { "const": false },
    "listener_preference_inference_from_affinity_allowed": { "const": false },
    "reaction_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "survey_ok_signal_class",
        "mission_ok_signal_class",
        "mission_ok_is_positive_preference"
      ],
      "properties": {
        "survey_ok_signal_class": { "const": "no_signal" },
        "mission_ok_signal_class": { "const": "weak_non_failure" },
        "mission_ok_is_positive_preference": { "const": false }
      }
    },
    "evidence_signals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence_signal" }
    },
    "rollups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by_family", "by_archetype", "by_artist", "by_album", "by_song"],
      "properties": {
        "by_family": { "type": "array", "items": { "$ref": "#/$defs/evidence_target_rollup" } },
        "by_archetype": { "type": "array", "items": { "$ref": "#/$defs/evidence_target_rollup" } },
        "by_artist": { "type": "array", "items": { "$ref": "#/$defs/evidence_target_rollup" } },
        "by_album": { "type": "array", "items": { "$ref": "#/$defs/evidence_target_rollup" } },
        "by_song": { "type": "array", "items": { "$ref": "#/$defs/evidence_target_rollup" } }
      }
    }
  },
  "$defs": {
    "object_type": {
      "enum": ["family", "archetype", "artist", "album", "song", "archetype_pair", "family_pair", "song_cluster"]
    },
    "source_type": {
      "enum": ["survey", "mission_review", "song_review", "synthetic"]
    },
    "raw_signal": {
      "enum": ["love", "like", "ok", "dislike", "unknown"]
    },
    "signal_class": {
      "enum": ["strong_positive", "positive", "weak_non_failure", "negative", "no_signal", "unknown"]
    },
    "node_tier": {
      "enum": ["primary", "major", "supporting", "deep", "contextual", "gateway", "unknown"]
    },
    "graph_item_role": {
      "enum": [
        "canonical_anchor",
        "major_representative",
        "gateway",
        "bridge",
        "deep_cut",
        "contextual_object",
        "boundary",
        "false_nearby",
        "album_world",
        "artist_anchor",
        "unknown"
      ]
    },
    "target_object_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_ids", "display_name"],
      "properties": {
        "object_type": { "$ref": "#/$defs/object_type" },
        "object_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "graph_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_object_ref",
        "family_ids",
        "family_names",
        "archetype_ids",
        "archetype_names",
        "artist_ids",
        "album_ids",
        "song_ids",
        "node_tier",
        "graph_item_role",
        "track_tier_within_archetype",
        "album_tier_within_archetype",
        "artist_tier_within_archetype",
        "context_overlays",
        "risk_flags",
        "identity_flags",
        "provenance"
      ],
      "properties": {
        "target_object_ref": { "$ref": "#/$defs/target_object_ref" },
        "family_ids": { "type": "array", "items": { "type": "string" } },
        "family_names": { "type": "array", "items": { "type": "string" } },
        "archetype_ids": { "type": "array", "items": { "type": "string" } },
        "archetype_names": { "type": "array", "items": { "type": "string" } },
        "artist_ids": { "type": "array", "items": { "type": "string" } },
        "album_ids": { "type": "array", "items": { "type": "string" } },
        "song_ids": { "type": "array", "items": { "type": "string" } },
        "node_tier": { "$ref": "#/$defs/node_tier" },
        "graph_item_role": { "$ref": "#/$defs/graph_item_role" },
        "track_tier_within_archetype": { "$ref": "#/$defs/node_tier" },
        "album_tier_within_archetype": { "$ref": "#/$defs/node_tier" },
        "artist_tier_within_archetype": { "$ref": "#/$defs/node_tier" },
        "context_overlays": { "type": "array", "items": { "type": "string" } },
        "risk_flags": { "type": "array", "items": { "type": "string" } },
        "identity_flags": { "type": "array", "items": { "type": "string" } },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "source_refs", "synthetic_only"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "source_refs": { "type": "array", "items": { "type": "string" } },
            "synthetic_only": { "type": "boolean" }
          }
        }
      }
    },
    "signal_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "survey_love",
        "survey_like",
        "survey_ok_ignored",
        "survey_dislike",
        "mission_love",
        "mission_like",
        "mission_ok_weak",
        "mission_dislike",
        "song_review_love",
        "song_review_like",
        "song_review_ok_weak",
        "song_review_dislike",
        "unknown",
        "total_preference_signals",
        "total_non_failure_signals"
      ],
      "properties": {
        "survey_love": { "type": "integer", "minimum": 0 },
        "survey_like": { "type": "integer", "minimum": 0 },
        "survey_ok_ignored": { "type": "integer", "minimum": 0 },
        "survey_dislike": { "type": "integer", "minimum": 0 },
        "mission_love": { "type": "integer", "minimum": 0 },
        "mission_like": { "type": "integer", "minimum": 0 },
        "mission_ok_weak": { "type": "integer", "minimum": 0 },
        "mission_dislike": { "type": "integer", "minimum": 0 },
        "song_review_love": { "type": "integer", "minimum": 0 },
        "song_review_like": { "type": "integer", "minimum": 0 },
        "song_review_ok_weak": { "type": "integer", "minimum": 0 },
        "song_review_dislike": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "total_preference_signals": { "type": "integer", "minimum": 0 },
        "total_non_failure_signals": { "type": "integer", "minimum": 0 }
      }
    },
    "computed_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_density",
        "positive_signal_strength",
        "negative_signal_strength",
        "weak_non_failure_strength",
        "conflict_score",
        "context_variability_score",
        "context_skew_score",
        "tier_coverage_score",
        "tier_depth_score",
        "coverage_gap_score",
        "depth_gap_score",
        "recency_score",
        "recent_surprise_score",
        "repetition_count"
      ],
      "properties": {
        "evidence_density": { "type": "number", "minimum": 0, "maximum": 1 },
        "positive_signal_strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "negative_signal_strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "weak_non_failure_strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "conflict_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "context_variability_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "context_skew_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "tier_coverage_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "tier_depth_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "coverage_gap_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "depth_gap_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "recency_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "recent_surprise_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "repetition_count": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_type",
        "raw_signal",
        "signal_class",
        "signal_weight",
        "contributes_to_preference",
        "can_support_non_failure",
        "target_object_ref",
        "graph_context",
        "occurred_at"
      ],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "source_type": { "$ref": "#/$defs/source_type" },
        "raw_signal": { "$ref": "#/$defs/raw_signal" },
        "signal_class": { "$ref": "#/$defs/signal_class" },
        "signal_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "contributes_to_preference": { "type": "boolean" },
        "can_support_non_failure": { "type": "boolean" },
        "target_object_ref": { "$ref": "#/$defs/target_object_ref" },
        "graph_context": { "$ref": "#/$defs/graph_context" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": { "const": "survey" },
              "raw_signal": { "const": "ok" }
            },
            "required": ["source_type", "raw_signal"]
          },
          "then": {
            "properties": {
              "signal_class": { "const": "no_signal" },
              "signal_weight": { "const": 0 },
              "contributes_to_preference": { "const": false },
              "can_support_non_failure": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_type": { "enum": ["mission_review", "song_review"] },
              "raw_signal": { "const": "ok" }
            },
            "required": ["source_type", "raw_signal"]
          },
          "then": {
            "properties": {
              "signal_class": { "const": "weak_non_failure" },
              "signal_weight": { "exclusiveMinimum": 0, "maximum": 0.25 },
              "contributes_to_preference": { "const": false },
              "can_support_non_failure": { "const": true }
            }
          }
        }
      ]
    },
    "evidence_target_rollup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollup_id",
        "target_object_ref",
        "graph_context",
        "signal_counts",
        "computed_fields",
        "supporting_evidence_ids"
      ],
      "properties": {
        "rollup_id": { "type": "string", "minLength": 1 },
        "target_object_ref": { "$ref": "#/$defs/target_object_ref" },
        "graph_context": { "$ref": "#/$defs/graph_context" },
        "signal_counts": { "$ref": "#/$defs/signal_counts" },
        "computed_fields": { "$ref": "#/$defs/computed_fields" },
        "supporting_evidence_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
