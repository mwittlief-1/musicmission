{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cartenza.local/contracts/mission_opportunity_selection/hidden_oracle_rank_usefulness_analysis_v0_1.schema.json",
  "title": "Cartenza Hidden Oracle Rank-Usefulness Analysis v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "fixture_status",
    "created_at",
    "phase",
    "runtime_allowed",
    "runtime_listener_evidence_connected",
    "production_mission_generation_allowed",
    "canonical_graph_mutation_allowed",
    "listener_preference_inference_from_affinity_allowed",
    "opportunity_only",
    "selector_may_read_hidden_oracle",
    "evaluator_may_read_hidden_oracle_after_selection",
    "source_hidden_oracle_evaluation_design_ref",
    "analysis_scope",
    "aggregate_summary",
    "profiles"
  ],
  "properties": {
    "contract_version": { "const": "hidden_oracle_rank_usefulness_analysis_v0_1" },
    "fixture_status": { "const": "synthetic_contract_fixture" },
    "created_at": { "type": "string", "format": "date-time" },
    "phase": { "const": "hidden_oracle_rank_usefulness_analysis" },
    "runtime_allowed": { "const": false },
    "runtime_listener_evidence_connected": { "const": false },
    "production_mission_generation_allowed": { "const": false },
    "canonical_graph_mutation_allowed": { "const": false },
    "listener_preference_inference_from_affinity_allowed": { "const": false },
    "opportunity_only": { "const": true },
    "selector_may_read_hidden_oracle": { "const": false },
    "evaluator_may_read_hidden_oracle_after_selection": { "const": true },
    "source_hidden_oracle_evaluation_design_ref": { "type": "string", "minLength": 1 },
    "analysis_scope": { "$ref": "#/$defs/analysis_scope" },
    "aggregate_summary": { "$ref": "#/$defs/aggregate_summary" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile_analysis" }
    }
  },
  "$defs": {
    "mission_type": {
      "enum": [
        "initial_profile_survey",
        "family_survey",
        "archetype_survey",
        "gateway_test",
        "song_to_archetype_test",
        "artist_depth_test",
        "album_container_test",
        "archetype_depth_test",
        "exception_scope_test",
        "false_nearby_test",
        "context_dependence_test",
        "bridge_test",
        "boundary_test",
        "evidence_repair_test"
      ]
    },
    "target_object_type": {
      "enum": [
        "family",
        "archetype",
        "artist",
        "album",
        "song",
        "archetype_pair",
        "family_pair",
        "song_cluster"
      ]
    },
    "bounded_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "correlation_score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "string_array": {
      "type": "array",
      "items": { "type": "string" }
    },
    "analysis_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_subject",
        "rank_window",
        "rank_score_field",
        "usefulness_score_field",
        "hidden_oracle_use",
        "selector_input_rule",
        "construction_simulation_status",
        "candidate_song_selection_status",
        "allowed_outputs"
      ],
      "properties": {
        "analysis_subject": { "const": "selected_opportunity_rank_order" },
        "rank_window": { "type": "integer", "minimum": 1, "maximum": 25 },
        "rank_score_field": { "const": "selected_opportunity_ref.final_opportunity_score" },
        "usefulness_score_field": { "const": "expected_metrics.learning_usefulness_score" },
        "hidden_oracle_use": { "const": "post_selection_metrics_only" },
        "selector_input_rule": { "const": "visible_evidence_only" },
        "construction_simulation_status": { "const": "not_implemented" },
        "candidate_song_selection_status": { "const": "not_in_scope" },
        "allowed_outputs": {
          "type": "array",
          "items": {
            "enum": [
              "rank_rows",
              "rank_usefulness_metrics",
              "mission_type_usefulness_summary",
              "aggregate_rank_alignment",
              "review_notes"
            ]
          }
        }
      }
    },
    "aggregate_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_count",
        "mean_top1_learning_usefulness_score",
        "mean_best_learning_usefulness_score",
        "mean_rank_regret",
        "top1_is_best_count",
        "best_in_top3_count",
        "best_in_top5_count",
        "mean_spearman_rank_correlation",
        "mean_ndcg_at_3",
        "mean_ndcg_at_5",
        "mean_ndcg_at_10",
        "alignment_label",
        "aggregate_findings"
      ],
      "properties": {
        "profile_count": { "type": "integer", "minimum": 0 },
        "mean_top1_learning_usefulness_score": { "$ref": "#/$defs/bounded_score" },
        "mean_best_learning_usefulness_score": { "$ref": "#/$defs/bounded_score" },
        "mean_rank_regret": { "$ref": "#/$defs/bounded_score" },
        "top1_is_best_count": { "type": "integer", "minimum": 0 },
        "best_in_top3_count": { "type": "integer", "minimum": 0 },
        "best_in_top5_count": { "type": "integer", "minimum": 0 },
        "mean_spearman_rank_correlation": { "$ref": "#/$defs/correlation_score" },
        "mean_ndcg_at_3": { "$ref": "#/$defs/bounded_score" },
        "mean_ndcg_at_5": { "$ref": "#/$defs/bounded_score" },
        "mean_ndcg_at_10": { "$ref": "#/$defs/bounded_score" },
        "alignment_label": { "enum": ["strong", "mixed", "weak"] },
        "aggregate_findings": { "$ref": "#/$defs/string_array" }
      }
    },
    "opportunity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "rank",
        "mission_type",
        "target_object_type",
        "target_object_ids",
        "target_display_name",
        "selector_score",
        "learning_usefulness_score"
      ],
      "properties": {
        "opportunity_id": { "type": "string", "minLength": 1 },
        "rank": { "type": "integer", "minimum": 1, "maximum": 25 },
        "mission_type": { "$ref": "#/$defs/mission_type" },
        "target_object_type": { "$ref": "#/$defs/target_object_type" },
        "target_object_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "target_display_name": { "type": "string", "minLength": 1 },
        "selector_score": { "$ref": "#/$defs/bounded_score" },
        "learning_usefulness_score": { "$ref": "#/$defs/bounded_score" }
      }
    },
    "rank_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "opportunity_id",
        "mission_type",
        "target_display_name",
        "selector_score",
        "learning_usefulness_score",
        "usefulness_rank",
        "usefulness_delta_from_top1",
        "oracle_match_tags"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 25 },
        "opportunity_id": { "type": "string", "minLength": 1 },
        "mission_type": { "$ref": "#/$defs/mission_type" },
        "target_display_name": { "type": "string", "minLength": 1 },
        "selector_score": { "$ref": "#/$defs/bounded_score" },
        "learning_usefulness_score": { "$ref": "#/$defs/bounded_score" },
        "usefulness_rank": { "type": "integer", "minimum": 1, "maximum": 25 },
        "usefulness_delta_from_top1": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "oracle_match_tags": { "$ref": "#/$defs/string_array" }
      }
    },
    "mission_type_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_type",
        "count",
        "best_selector_rank",
        "best_usefulness_rank",
        "mean_learning_usefulness_score",
        "max_learning_usefulness_score"
      ],
      "properties": {
        "mission_type": { "$ref": "#/$defs/mission_type" },
        "count": { "type": "integer", "minimum": 1 },
        "best_selector_rank": { "type": "integer", "minimum": 1, "maximum": 25 },
        "best_usefulness_rank": { "type": "integer", "minimum": 1, "maximum": 25 },
        "mean_learning_usefulness_score": { "$ref": "#/$defs/bounded_score" },
        "max_learning_usefulness_score": { "$ref": "#/$defs/bounded_score" }
      }
    },
    "profile_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "selector_output_ref",
        "evaluation_design_profile_ref",
        "rank_window",
        "top_selector_opportunity",
        "best_oracle_usefulness_opportunity",
        "top1_learning_usefulness_score",
        "best_learning_usefulness_score",
        "rank_regret",
        "best_usefulness_rank",
        "top1_is_best",
        "best_in_top3",
        "best_in_top5",
        "spearman_rank_correlation",
        "ndcg_at_3",
        "ndcg_at_5",
        "ndcg_at_10",
        "rank_rows",
        "mission_type_usefulness_summary",
        "diagnostic_findings",
        "recommended_selector_tuning_notes"
      ],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "selector_output_ref": { "type": "string", "minLength": 1 },
        "evaluation_design_profile_ref": { "type": "string", "minLength": 1 },
        "rank_window": { "type": "integer", "minimum": 1, "maximum": 25 },
        "top_selector_opportunity": { "$ref": "#/$defs/opportunity_ref" },
        "best_oracle_usefulness_opportunity": { "$ref": "#/$defs/opportunity_ref" },
        "top1_learning_usefulness_score": { "$ref": "#/$defs/bounded_score" },
        "best_learning_usefulness_score": { "$ref": "#/$defs/bounded_score" },
        "rank_regret": { "$ref": "#/$defs/bounded_score" },
        "best_usefulness_rank": { "type": "integer", "minimum": 1, "maximum": 25 },
        "top1_is_best": { "type": "boolean" },
        "best_in_top3": { "type": "boolean" },
        "best_in_top5": { "type": "boolean" },
        "spearman_rank_correlation": { "$ref": "#/$defs/correlation_score" },
        "ndcg_at_3": { "$ref": "#/$defs/bounded_score" },
        "ndcg_at_5": { "$ref": "#/$defs/bounded_score" },
        "ndcg_at_10": { "$ref": "#/$defs/bounded_score" },
        "rank_rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": { "$ref": "#/$defs/rank_row" }
        },
        "mission_type_usefulness_summary": {
          "type": "array",
          "items": { "$ref": "#/$defs/mission_type_summary" }
        },
        "diagnostic_findings": { "$ref": "#/$defs/string_array" },
        "recommended_selector_tuning_notes": { "$ref": "#/$defs/string_array" }
      }
    }
  }
}
