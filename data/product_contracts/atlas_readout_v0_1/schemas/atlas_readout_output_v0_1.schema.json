{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cartenza.local/schemas/atlas_readout_output_v0_1.schema.json",
  "title": "AtlasReadoutOutput v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "readout_title",
    "readout_subtitle",
    "opening_read",
    "signal_cards",
    "song_shape_summary",
    "uncertainty_cards",
    "mission_bridge",
    "internal_quality_notes"
  ],
  "properties": {
    "readout_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "readout_subtitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "opening_read": {
      "type": "string",
      "minLength": 1,
      "maxLength": 900
    },
    "signal_cards": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/signal_card"
      }
    },
    "song_shape_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "bullets"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 420
        },
        "bullets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 170
          }
        }
      }
    },
    "uncertainty_cards": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/uncertainty_card"
      }
    },
    "mission_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "mission_teasers"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 420
        },
        "mission_teasers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 170
          }
        }
      }
    },
    "internal_quality_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used_affinity_tags", "avoided_claims", "risk_flags"],
      "properties": {
        "used_affinity_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "avoided_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "signal_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "confidence", "evidence_examples"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 420
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "evidence_examples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "uncertainty_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "why_it_matters"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 420
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        }
      }
    }
  }
}
