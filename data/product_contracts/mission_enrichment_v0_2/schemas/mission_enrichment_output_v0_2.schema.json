{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cartenza.local/contracts/mission_enrichment/mission_enrichment_output_v0_2.schema.json",
  "title": "Cartenza Mission Enrichment Output v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "mission_copy",
    "route_item_copy",
    "secondary_reaction_tag_candidates",
    "post_completion_interpretation_seeds",
    "internal_quality_notes"
  ],
  "properties": {
    "schema_version": { "const": "mission_enrichment_output_v0_2" },
    "mission_id": { "type": "string", "minLength": 1 },
    "mission_copy": { "$ref": "#/$defs/mission_copy" },
    "route_item_copy": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route_item_copy" }
    },
    "secondary_reaction_tag_candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/secondary_reaction_tag_candidates" }
    },
    "post_completion_interpretation_seeds": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/post_completion_interpretation_seed" }
    },
    "internal_quality_notes": { "$ref": "#/$defs/internal_quality_notes" }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "mission_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "short_description",
        "why_now",
        "listen_for",
        "mission_hypothesis_user_facing"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "subtitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "short_description": { "type": "string", "minLength": 1, "maxLength": 420 },
        "why_now": { "type": "string", "minLength": 1, "maxLength": 320 },
        "listen_for": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "mission_hypothesis_user_facing": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        }
      }
    },
    "route_item_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "pre_play_line", "why_this_song", "listen_for"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "pre_play_line": { "type": "string", "minLength": 1, "maxLength": 180 },
        "why_this_song": { "type": "string", "minLength": 1, "maxLength": 260 },
        "listen_for": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "primary_reaction": {
      "enum": ["love", "like", "ok", "dislike"]
    },
    "atlas_signal_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_type", "target_labels"],
      "properties": {
        "target_type": {
          "enum": [
            "affinity_tag",
            "pattern",
            "region",
            "mission_hypothesis",
            "boundary",
            "frontier",
            "context_rule"
          ]
        },
        "target_labels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "secondary_tag_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag_id",
        "rank",
        "display_label",
        "valid_primary_reactions",
        "why_this_tag_is_relevant",
        "linked_song_affinity_tags",
        "linked_user_alignment_hints",
        "atlas_effect",
        "atlas_signal_target"
      ],
      "properties": {
        "tag_id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "rank": { "type": "integer", "minimum": 1, "maximum": 6 },
        "display_label": { "type": "string", "minLength": 1 },
        "valid_primary_reactions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/primary_reaction" }
        },
        "why_this_tag_is_relevant": { "type": "string", "minLength": 1, "maxLength": 360 },
        "linked_song_affinity_tags": { "$ref": "#/$defs/string_array" },
        "linked_user_alignment_hints": { "$ref": "#/$defs/string_array" },
        "atlas_effect": { "type": "string", "minLength": 1 },
        "atlas_signal_target": { "$ref": "#/$defs/atlas_signal_target" }
      }
    },
    "secondary_reaction_tag_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "tags"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/secondary_tag_candidate" }
        }
      }
    },
    "post_completion_interpretation_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "readout_seed", "atlas_inference_hint"],
      "properties": {
        "condition": { "enum": ["mostly_positive", "mixed", "mostly_negative"] },
        "readout_seed": { "type": "string", "minLength": 1, "maxLength": 320 },
        "atlas_inference_hint": { "type": "string", "minLength": 1, "maxLength": 320 }
      }
    },
    "internal_quality_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used_song_affinity_tags",
        "used_alignment_hints",
        "avoided_overclaims",
        "risk_flags"
      ],
      "properties": {
        "used_song_affinity_tags": { "$ref": "#/$defs/string_array" },
        "used_alignment_hints": { "$ref": "#/$defs/string_array" },
        "avoided_overclaims": { "$ref": "#/$defs/string_array" },
        "risk_flags": { "$ref": "#/$defs/string_array" }
      }
    }
  }
}
