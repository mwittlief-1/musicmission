                "neutral",
                "dislike",
                "skip",
                "know",
                "dont_know",
                "want_more",
                "too_much",
                "false_match",
                "not_for_me",
                "unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_reaction": {
          "$ref": "#/$defs/nullable_string"
        },
        "normalized_signal": {
          "$ref": "#/$defs/nullable_string"
        },
