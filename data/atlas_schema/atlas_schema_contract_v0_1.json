{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waymark.local/schemas/atlas_schema_contract_v0_1.json",
  "title": "Waymark Atlas Schema Contract v0.1",
  "description": "Provisional schema contract for Waymark's user-specific Atlas interpretation layer. This schema references canonical graph objects when available and supports user-local, external-catalog, unresolved, and composition-placeholder music objects without mutating the canonical graph.",
  "oneOf": [
    {
      "$ref": "#/$defs/atlas_record"
    },
    {
      "$ref": "#/$defs/atlas_example_bundle"
    }
  ],
  "$defs": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nullable_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "description": "ISO-8601 timestamp with timezone, for example 2026-05-20T14:30:00-04:00."
    },
    "confidence_band": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "confidence_basis": {
      "type": "string",
      "enum": [
        "direct_user_reaction",
        "repeated_user_behavior",
        "explicit_user_note",
        "survey_pattern",
        "mission_review",
        "import_context",
        "editorial_seed",
        "generated_hypothesis",
        "mixed"
      ]
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence_score",
        "confidence_band",
        "confidence_basis",
        "confidence_summary"
      ],
      "properties": {
        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence_band": {
          "$ref": "#/$defs/confidence_band"
        },
        "confidence_basis": {
          "$ref": "#/$defs/confidence_basis"
        },
        "confidence_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "review_state",
        "promotion_state"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "active",
            "suppressed",
            "archived",
            "provisional"
          ]
        },
        "review_state": {
          "type": "string",
          "enum": [
            "unreviewed",
            "needs_review",
            "reviewed",
            "rejected"
          ]
        },
        "promotion_state": {
          "type": "string",
          "enum": [
            "proposed",
            "candidate",
            "promoted",
            "demoted",
            "blocked"
          ]
        }
      }
    },
    "atlas_role": {
      "type": "string",
      "enum": [
        "landmark",
        "region",
        "frontier",
        "dead_end",
        "waypoint",
        "unknown",
        "signal_only"
      ]
    },
    "signal_source": {
      "type": "string",
      "enum": [
        "survey",
        "mission",
        "open_road",
        "import",
        "note",
        "review",
        "playback"
      ]
    },
    "music_object_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "ref_source",
        "canonical_artist_id",
        "canonical_album_id",
        "canonical_song_recording_id",
        "composition_placeholder_id",
        "user_music_object_id",
        "external_catalog_refs",
        "display_name",
        "resolution_state",
        "composition_policy_status"
      ],
      "properties": {
        "object_type": {
          "type": "string",
          "enum": [
            "artist",
            "album",
            "song_recording",
            "composition_placeholder"
          ]
        },
        "ref_source": {
          "type": "string",
          "enum": [
            "canonical_graph",
            "user_local",
            "external_catalog",
            "unresolved"
          ]
        },
        "canonical_artist_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "canonical_album_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "canonical_song_recording_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "composition_placeholder_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "user_music_object_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "external_catalog_refs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "credited_artist_name": {
          "$ref": "#/$defs/nullable_string"
        },
        "credit_context": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "solo",
                "group",
                "duet",
                "featured",
                "cast",
                "church_brand",
                "producer_project",
                "fictional_performer",
                "various_artists",
                "unknown",
                "not_applicable"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution_state": {
          "type": "string",
          "enum": [
            "resolved",
            "needs_resolution",
            "intentionally_user_local"
          ]
        },
        "composition_policy_status": {
          "type": "string",
          "enum": [
            "resolved",
            "needs_review",
            "not_applicable",
            "no_review_needed",
            "composition_first_required",
            "split_confirmed"
          ]
        },
        "recording_variant_type": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "source",
                "hit_cover",
                "live",
                "radio_edit",
                "remix",
                "clean",
                "explicit",
                "cast",
                "soundtrack_pop",
                "traditional_arrangement",
                "studio",
                "unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "canonical_membership_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "family_numbers": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "archetype_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "membership_role_notes": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ref_source": {
                "const": "canonical_graph"
              },
              "object_type": {
                "const": "artist"
              }
            }
          },
          "then": {
            "properties": {
              "canonical_artist_id": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ref_source": {
                "const": "canonical_graph"
              },
              "object_type": {
                "const": "album"
              }
            }
          },
          "then": {
            "properties": {
              "canonical_album_id": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ref_source": {
                "const": "canonical_graph"
              },
              "object_type": {
                "const": "song_recording"
              }
            }
          },
          "then": {
            "properties": {
              "canonical_song_recording_id": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "object_type": {
                "const": "composition_placeholder"
              }
            }
          },
          "then": {
            "properties": {
              "composition_placeholder_id": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ref_source": {
                "const": "user_local"
              }
            }
          },
          "then": {
            "properties": {
              "user_music_object_id": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ref_source": {
                "const": "external_catalog"
              }
            }
          },
          "then": {
            "properties": {
              "external_catalog_refs": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ref_source": {
                "const": "unresolved"
              }
            }
          },
          "then": {
            "properties": {
              "resolution_state": {
                "const": "needs_resolution"
              }
            }
          }
        }
      ]
    },
    "atlas_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "atlas_node_id",
        "user_id",
        "node_type",
        "display_name",
        "music_object_ref",
        "origin",
        "lifecycle",
        "confidence",
        "evidence_signal_ids",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "record_type": {
          "const": "atlas_node"
        },
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "atlas_node_id": {
          "$ref": "#/$defs/id"
        },
        "user_id": {
          "$ref": "#/$defs/id"
        },
        "node_type": {
          "type": "string",
          "enum": [
            "artist",
            "album",
            "song_recording",
            "composition_placeholder",
            "scene",
            "era",
            "genre_lane",
            "taste_feature",
            "user_defined_concept",
            "mission_derived_concept"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "$ref": "#/$defs/nullable_string"
        },
        "music_object_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/music_object_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "$ref": "#/$defs/signal_source"
        },
        "render_hints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary_label": {
              "type": "string"
            },
            "secondary_label": {
              "type": "string"
            },
            "card_summary": {
              "type": "string"
            }
          }
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence_signal_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "atlas_role_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "atlas_role_assignment_id",
        "user_id",
        "atlas_node_id",
        "role",
        "scope",
        "candidate_pool_behavior",
        "lifecycle",
        "confidence",
        "evidence_signal_ids",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "record_type": {
          "const": "atlas_role_assignment"
        },
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "atlas_role_assignment_id": {
          "$ref": "#/$defs/id"
        },
        "user_id": {
          "$ref": "#/$defs/id"
        },
        "atlas_node_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "$ref": "#/$defs/atlas_role"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_type",
            "scope_id",
            "scope_label"
          ],
          "properties": {
            "scope_type": {
              "type": "string",
              "enum": [
                "global",
                "road",
                "mission",
                "family",
                "scene",
                "era",
                "query"
              ]
            },
            "scope_id": {
              "$ref": "#/$defs/nullable_id"
            },
            "scope_label": {
              "$ref": "#/$defs/nullable_string"
            }
          }
        },
        "candidate_pool_behavior": {
          "type": "string",
          "enum": [
            "anchor",
            "bridge",
            "probe",
            "risky_probe",
            "waypoint",
            "trap",
            "exclude",
            "unknown"
          ]
        },
        "assignment_summary": {
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence_signal_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "road": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "road_id",
        "user_id",
        "name",
        "purpose",
        "node_refs",
        "role_assignment_ids",
        "constraints",
        "lifecycle",
        "confidence",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "record_type": {
          "const": "road"
        },
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "road_id": {
          "$ref": "#/$defs/id"
        },
        "user_id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "enum": [
            "open_road",
            "mission_route",
            "survey_route",
            "atlas_view",
            "manual_collection"
          ]
        },
        "node_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "atlas_node_id",
              "route_function"
            ],
            "properties": {
              "atlas_node_id": {
                "$ref": "#/$defs/id"
              },
              "route_function": {
                "type": "string",
                "enum": [
                  "start",
                  "anchor",
                  "bridge",
                  "waypoint",
                  "fork",
                  "destination",
                  "boundary",
                  "trap",
                  "context"
                ]
              }
            }
          }
        },
        "role_assignment_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "lineage_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "lineage_edge_id",
        "user_id",
        "from_atlas_node_id",
        "to_atlas_node_id",
        "edge_type",
        "direction",
        "lifecycle",
        "confidence",
        "evidence_signal_ids",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "record_type": {
          "const": "lineage_edge"
        },
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "lineage_edge_id": {
          "$ref": "#/$defs/id"
        },
        "user_id": {
          "$ref": "#/$defs/id"
        },
        "from_atlas_node_id": {
          "$ref": "#/$defs/id"
        },
        "to_atlas_node_id": {
          "$ref": "#/$defs/id"
        },
        "edge_type": {
          "type": "string",
          "enum": [
            "influence",
            "source_recording",
            "cover_of",
            "adjacent_scene",
            "false_nearby",
            "shared_composition",
            "credit_relation",
            "user_perceived_lineage",
            "generated_hypothesis"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "directed",
            "undirected"
          ]
        },
        "policy_note": {
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence_signal_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "taste_feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "taste_feature_id",
        "feature_key",
        "display_name",
        "definition",
        "feature_type",
        "global_status",
        "canonical_examples",
        "anti_examples",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "record_type": {
          "const": "taste_feature"
        },
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "taste_feature_id": {
          "$ref": "#/$defs/id"
        },
        "feature_key": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "feature_type": {
          "type": "string",
          "enum": [
            "sonic",
            "lyrical",
            "social",
            "production",
            "performance",
            "format",
            "affective",
            "avoidance",
            "meta",
            "structural"
          ]
        },
        "global_status": {
          "type": "string",
          "enum": [
            "active",
            "suppressed",
            "deprecated",
            "provisional"
          ]
        },
        "canonical_examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/music_object_ref"
          }
        },
        "anti_examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/music_object_ref"
          }
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "user_taste_feature_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "user_taste_feature_state_id",
        "user_id",
        "taste_feature_id",
        "state",
        "affinity",
        "intensity_score",
        "representative_music_object_refs",
        "linked_atlas_node_ids",
        "user_vocabulary_term_ids",
        "lifecycle",
        "confidence",
        "evidence_signal_ids",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "record_type": {
          "const": "user_taste_feature_state"
        },
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "user_taste_feature_state_id": {
          "$ref": "#/$defs/id"
        },
        "user_id": {
          "$ref": "#/$defs/id"
        },
        "taste_feature_id": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "dormant",
            "rejected",
            "uncertain",
            "suppressed",
            "provisional"
          ]
        },
        "affinity": {
          "type": "string",
          "enum": [
            "likes",
            "seeks",
            "avoids",
            "contextual",
            "ambivalent",
            "unknown"
          ]
        },
        "intensity_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "representative_music_object_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/music_object_ref"
          }
        },
        "linked_atlas_node_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "user_vocabulary_term_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence_signal_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "signal_id",
        "user_id",
        "source",
        "event_type",
        "occurred_at",
        "captured_at",
        "subject_music_object_ref",
        "subject_atlas_node_id",
        "reaction_value",
        "observed_user_tags",
        "user_note",
        "signal_strength",
        "interpretation_confidence",
        "confidence",
        "derived_update_candidate_ids",
        "lifecycle"
      ],
      "properties": {
        "record_type": {
          "const": "signal"
        },
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "signal_id": {
          "$ref": "#/$defs/id"
        },
        "user_id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/signal_source"
        },
        "event_type": {
