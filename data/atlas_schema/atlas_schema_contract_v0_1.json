          "type": "array",
          "description": "Visible user-selected tags only. Simulator-private hidden reason tags must not appear here.",
          "items": {
            "type": "string"
          }
        },
        "shown_unselected_tags": {
          "type": "array",
          "description": "Visible tags shown to the user but not selected. Empty arrays are preserved as evidence absence, not as taste truth.",
          "items": {
            "type": "string"
          }
        },
        "user_note": {
          "$ref": "#/$defs/nullable_string"
        },
        "source_context": {
          "type": "object",
          "description": "Visible source/provenance context for audit and replay. Hidden simulator/private fields must not be stored here."
        },
        "page_context": {
          "type": "object",
          "description": "Visible page/tile context retained for deterministic ingestion and QA. Page construction metadata must not become user-facing Atlas copy."
        },
        "apple_exposure_context": {
          "type": "object",
          "description": "Apple Music evidence retained as exposure/import/familiarity context, not taste truth."
