        "source": {
          "type": "string",
          "enum": [
            "survey",
            "mission_generation",
            "mission_review",
            "open_road",
            "note",
            "import",
            "review"
          ]
        },
        "source_signal_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "target_atlas_node_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "target_role_assignment_id": {
          "$ref": "#/$defs/nullable_id"
        },
        "proposed_record_type": {
          "type": "string",
          "enum": [
            "atlas_node",
            "atlas_role_assignment",
            "road",
            "lineage_edge",
            "user_taste_feature_state",
            "user_vocabulary_term"
          ]
        },
        "proposed_action": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "suppress",
            "archive",
            "promote",
            "demote",
            "block",
            "merge_request",
            "resolution_request"
          ]
        },
        "proposed_payload": {
          "type": "object",
          "description": "Patch-like payload for the target Atlas record. This payload may reference canonical graph IDs but must not write to canonical graph tables."
        },
        "confidence_delta": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "recurrence_requirement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_count",
            "min_distinct_sources",
            "satisfied"
          ],
          "properties": {
            "required_count": {
              "type": "integer",
              "minimum": 0
            },
            "min_distinct_sources": {
              "type": "integer",
              "minimum": 0
            },
            "satisfied": {
              "type": "boolean"
            }
          }
        },
        "review_requirement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "reviewer_type",
            "reason"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "reviewer_type": {
              "type": "string",
              "enum": [
                "human",
                "policy",
                "product",
                "none"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "canonical_graph_mutation_allowed": {
          "const": false
        },
        "generated_hypothesis_only": {
          "type": "boolean"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "survey",
                  "mission_generation",
                  "mission_review"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "lifecycle": {
                "type": "object",
                "properties": {
                  "promotion_state": {
                    "enum": [
                      "proposed",
                      "candidate",
                      "blocked"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "mission_review"
              }
            }
          },
          "then": {
            "properties": {
              "review_requirement": {
                "type": "object",
                "properties": {
                  "required": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    },
