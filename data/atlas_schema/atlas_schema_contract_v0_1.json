        "source_signal_ids",
        "target_atlas_node_id",
        "target_role_assignment_id",
        "proposed_record_type",
        "proposed_action",
        "proposed_payload",
        "confidence_delta",
        "recurrence_requirement",
        "review_requirement",
        "canonical_graph_mutation_allowed",
        "generated_hypothesis_only",
        "lifecycle",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "record_type": {
          "const": "possible_atlas_update_candidate"
        },
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
