OPENAI_API_KEY=
CARTENZA_OPENAI_MODEL=gpt-4.1
CARTENZA_OPENAI_API_STYLE=responses
CARTENZA_OPENAI_TEMPERATURE=0.4
CARTENZA_OPENAI_MAX_OUTPUT_TOKENS=12000
CARTENZA_OPENAI_TIMEOUT_SECONDS=300
# Optional for models that support it:
# CARTENZA_OPENAI_REASONING_EFFORT=medium
# Optional cost hook override. By default the harness uses
# fixtures/pricing/openai_pricing_v0_3.json.
# Values are USD per 1M input/cached-input/output tokens.
# CARTENZA_MODEL_PRICING_JSON={"models":{"gpt-4.1":{"input_per_1m":2,"cached_input_per_1m":0.5,"output_per_1m":8}}}
# CARTENZA_MODEL_PRICING_FILE=fixtures/pricing/openai_pricing_v0_3.json
#
# Legacy WAYMARK_* aliases are still accepted during the Cartenza transition.
