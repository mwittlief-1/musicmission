OPENAI_API_KEY=
WAYMARK_OPENAI_MODEL=gpt-4.1
WAYMARK_OPENAI_API_STYLE=responses
WAYMARK_OPENAI_TEMPERATURE=0.4
WAYMARK_OPENAI_MAX_OUTPUT_TOKENS=12000
WAYMARK_OPENAI_TIMEOUT_SECONDS=300
# Optional for models that support it:
# WAYMARK_OPENAI_REASONING_EFFORT=medium
# Optional cost hook override. By default the harness uses
# fixtures/pricing/openai_pricing_v0_3.json.
# Values are USD per 1M input/cached-input/output tokens.
# WAYMARK_MODEL_PRICING_JSON={"models":{"gpt-4.1":{"input_per_1m":2,"cached_input_per_1m":0.5,"output_per_1m":8}}}
# WAYMARK_MODEL_PRICING_FILE=fixtures/pricing/openai_pricing_v0_3.json
