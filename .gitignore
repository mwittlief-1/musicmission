.DS_Store

# Xcode
build/
DerivedData/
*.xcarchive/
*.xcresult/
*.dSYM/
*.ipa
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.moved-aside
*.xccheckout
*.xcscmblueprint

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local secrets
waymark-ai-tests/.env
waymark-ai-tests/.env.*
!waymark-ai-tests/.env.example
waymark-atlas-tests/.env
waymark-atlas-tests/.env.*
!waymark-atlas-tests/.env.example
supabase/functions/.env
supabase/functions/.env.*
