supabase/.temp/

# Local exports
data/exports/*
!data/exports/.gitkeep
!data/exports/dev/
data/exports/dev/*
!data/exports/dev/.gitkeep
!data/exports/acceptance/
data/exports/acceptance/*
!data/exports/acceptance/.gitkeep

# Generated packets and review archives
data/*.zip
data/**/*.zip
review_packets/*.zip
waymark-ai-tests/review_packets/*.zip

# Generated test harness outputs
waymark-ai-tests/outputs/*
